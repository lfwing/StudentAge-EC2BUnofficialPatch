<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <!-- These executables share a source folder, but must not race over apphost,
         restore assets or generated assembly metadata when checks run together. -->
    <BaseIntermediateOutputPath>obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
